# Vorlage für die Konfiguration. Kopieren nach ".env" und ausfüllen.
# Die echte .env wird nicht eingecheckt (siehe .gitignore).

# Postfach (DomainFactory, IMAP)
IMAP_SERVER=imap.example.com
IMAP_USER=postfach@example.com
IMAP_PASSWORD=

# Filter für die CSV-Mail des PMS
ABSENDER_FILTER=pms@example.com
BETREFF_FILTER=Anreise

# Speicherorte auf dem NAS
DB_PATH=/pfad/zum/nas/pre_arrival.sqlite
DOWNLOAD_DIR=/pfad/zum/nas/downloads
