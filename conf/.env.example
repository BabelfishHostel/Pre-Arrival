# Vorlage für die Konfiguration. Kopieren nach "conf/.env" und ausfüllen.
# Relative Pfade gelten ab der Projektwurzel (Ordner über src/).
# Die echte .env wird nicht eingecheckt (siehe .gitignore).

# Postfach (IMAP)
# Microsoft 365 / Exchange Online: IMAP_SERVER=outlook.office365.com
IMAP_SERVER=outlook.office365.com
IMAP_USER=test@babelfish-hostel.de

# Anmeldung - entweder Passwort (klassisches IMAP) ...
IMAP_PASSWORD=

# ... oder OAuth2 für Microsoft 365 (IMAP_PASSWORD dann leer lassen, `pip install msal`)
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# Filter für die CSV-Mail des PMS (reines ASCII)
ABSENDER_FILTER=info@babelfish-hostel.de
BETREFF_FILTER=Anreise in 3 Tagen

# Speicherorte auf dem NAS
DB_PATH=data/pre_arrival.sqlite
DOWNLOAD_DIR=data/downloads

# Optional (Standardwerte)
IMAP_PORT=993
VERARBEITET_ORDNER=Anreise in 3 Tagen
RETENTION_DAYS=30

EVENTS_SHEET_ID=
EVENTSEITE_URL=https://www.babelfish-hostel.de/wuerzburg-tipps/

# --- Versand-Job (run_send.py) ---
# Mail.Send-Berechtigung der Azure-App nötig (Anwendung, Graph). Ohne AZURE_* läuft nur der Trockenlauf.
SEND_ABSENDER=info@babelfish-hostel.de
GRAPH_POSTFACH=info@babelfish-hostel.de
# Eigene Azure-App nur für den Versand (empfohlen): hat Vorrang vor AZURE_*, Tenant-ID kommt aus AZURE_TENANT_ID
# (oder GRAPH_TENANT_ID). Die App bekommt KEINE Graph-Berechtigung in Entra, sondern Exchange-RBAC "Application Mail.Send"
# beschränkt auf das Postfach (siehe docs/README-PreArrival.md, Abschnitt Azure-App für den Versand).
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# SEND_TAGE_VORHER=3          # Anreisen von heute bis heute+N Tage gelten als fällig
# SPRACHE_STANDARD=de         # wenn die CSV/PLZ-Regel keine Sprache ergibt
# STORNO_TAGE=2              # die letzten N Tage vor Anreise sind nicht mehr kostenfrei, letzter freier Tag = Anreise - N - 1 (Frist-Satz)
ZAHLUNG_REGEL=paylink          # flex: Zahlungsblock nur bei Rate Flex | paylink: bei jedem EGB-Gast mit offenem Paylink
# ZAHLUNGSFRIST_TAGE=1        # Zahlungsfrist = Anreise minus N Tage; leer = keine Frist in der Mail
# MAX_IMPORT_ALTER_TAGE=0    # ältester erlaubter CSV-Import für den Versand in Tagen (0 = nur von heute); ist der
#                            # letzte Import älter, sendet --live nichts (Gästeliste womöglich veraltet)

# SEND_ANREISE_AB=2026-12-01 # Startregel für den Livegang: Gäste mit früherer Anreise bekommen keine Mail. Am Starttag auf den
#                            # Folgetag setzen; muss später nicht entfernt werden (ein vergangenes Datum hat keine Wirkung)
# SEND_KOPIE_AN=           # Blindkopie (BCC) jeder Gästemail, nur im Live-Modus, z. B. zur Überwachung am Anfang (mehrere mit Komma); leer = keine
# VERSAND_AUSNAHMEN=conf/versand_ausnahmen.txt   # Adressen/Domains ohne Mail (Beispiel: conf/versand_ausnahmen.example.txt)

# --- Tagesjob (run_daily.py) ---
SEND_MODUS=vorschau         # vorschau (Standard): nichts senden, HTML-Vorschauen ablegen | live: echter Versand
# VORSCHAU_DIR=data/vorschau   # enthält Gästedaten und Paylinks -> nicht freigeben
# VORSCHAU_TAGE=7             # Vorschau-Dateien werden nach N Tagen gelöscht
# HEALTHCHECK_URL=https://hc-ping.com/<uuid>   # Ping nach erfolgreichem Lauf mit Import von heute
# EVENTS_SHEET_ID=            # ID des öffentlichen Google Sheets
# EVENTS_TAB=Veranstaltungen
# EVENTSEITE_URL=https://www.babelfish-hostel.de/wuerzburg-tipps/   # Link für den Fallback-Satz
