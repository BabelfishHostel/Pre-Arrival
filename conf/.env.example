# Vorlage für die Konfiguration. Kopieren nach "conf/.env" und ausfüllen.
# Relative Pfade gelten ab der Projektwurzel (Ordner über src/).
# Die echte .env wird nicht eingecheckt (siehe .gitignore).

# Postfach (IMAP)
# Microsoft 365 / Exchange Online: IMAP_SERVER=outlook.office365.com
IMAP_SERVER=imap.example.com
IMAP_USER=postfach@example.com

# Anmeldung - entweder Passwort (klassisches IMAP) ...
IMAP_PASSWORD=

# ... oder OAuth2 für Microsoft 365 (IMAP_PASSWORD dann leer lassen, `pip install msal`)
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# Filter für die CSV-Mail des PMS (reines ASCII)
ABSENDER_FILTER=pms@example.com
BETREFF_FILTER=Anreise

# Speicherorte auf dem NAS
DB_PATH=data/pre_arrival.sqlite
DOWNLOAD_DIR=data/downloads

# Optional (Standardwerte)
# IMAP_PORT=993
# VERARBEITET_ORDNER=Verarbeitet   # z. B. "Anreise in 3 Tagen"; nur ASCII, keine Umlaute
# RETENTION_DAYS=30

# --- Versand-Job (run_send.py) ---
# Mail.Send-Berechtigung der Azure-App nötig (Anwendung, Graph). Ohne AZURE_* läuft nur der Trockenlauf.
# SEND_ABSENDER=info@babelfish-hostel.de
# GRAPH_POSTFACH=info@babelfish-hostel.de
# SEND_TAGE_VORHER=3          # Anreisen von heute bis heute+N Tage gelten als fällig
# SPRACHE_STANDARD=de         # wenn die CSV/PLZ-Regel keine Sprache ergibt
# STORNO_TAGE=2               # kostenfreie Stornierung bis N Tage vor Anreise (steuert den Frist-Satz in der Mail)

# --- Tagesjob (run_daily.py) ---
# SEND_MODUS=vorschau         # vorschau (Standard): nichts senden, HTML-Vorschauen ablegen | live: echter Versand
# VORSCHAU_DIR=data/vorschau   # enthält Gästedaten und Paylinks -> nicht freigeben
# VORSCHAU_TAGE=7             # Vorschau-Dateien werden nach N Tagen gelöscht
# HEALTHCHECK_URL=https://hc-ping.com/<uuid>   # Ping nach erfolgreichem Lauf mit Import von heute
# EVENTS_SHEET_ID=            # ID des öffentlichen Google Sheets
# EVENTS_TAB=Veranstaltungen
# EVENTSEITE_URL=https://www.babelfish-hostel.de/wuerzburg-tipps/   # Link für den Fallback-Satz
